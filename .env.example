# ============================================================
# J.A.R.V.I.S. — variables de entorno
# Copia este archivo a .env.local. Con los valores simulados de abajo
# la app arranca en MODO SIMULADO: todo funciona en local (IndexedDB),
# sin llamar a Supabase, Stripe, PayPal, Google, OpenAI ni Anthropic.
# ============================================================

# --- SUPABASE ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...ANON_KEY_SIMULADA
SUPABASE_SERVICE_ROLE_KEY=eyJ...SERVICE_ROLE_SIMULADA

# --- PAGOS ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=sb-...
PAYPAL_SECRET=...

# --- CEREBRO (servidor; el usuario nunca introduce claves) ---
# Google Gemini, capa gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo(s) de Gemini separados por comas (por defecto gemini-flash-lite-latest…)
GEMINI_MODEL=
# Opcional: futuro cambio a Claude. Con AI_PRIMARY=anthropic y la clave, Claude va primero.
ANTHROPIC_API_KEY=sk-ant-...
AI_PRIMARY=

# --- VOZ (TTS / STT) ---
# Google Cloud Text-to-Speech (voces Chirp 3 HD). Sin ella se usa Gemini TTS con GEMINI_API_KEY.
GOOGLE_TTS_API_KEY=
# Opcional: modelo de Gemini TTS (por defecto gemini-3.8-flash-lite-tts)
GEMINI_TTS_MODEL=
# Whisper (transcripción) con OpenAI, opcional
OPENAI_API_KEY=sk-proj-...

# --- CORREO (opcional, cuando haya dominio propio; ver docs/AUTH_SETUP.md) ---
# El login lo envía Supabase con su SMTP. Estas solo harán falta para otros correos de la app.
RESEND_API_KEY=
EMAIL_FROM="J.A.R.V.I.S. <hola@tudominio.com>"

# --- PERMISOS TOTALES (OAuth) ---
GOOGLE_CLIENT_ID=
NOTION_API_KEY=

# --- APP ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Variables adicionales exigidas por la especificación
# ============================================================

# Fuerza el modo simulado aunque las claves parezcan reales (true/false).
# Si se deja vacío, se detecta solo: claves con "SIMULADA", "tu-proyecto" o "..." => simulado.
NEXT_PUBLIC_MOCK_MODE=

# --- PROPIETARIO ---
# Los dos propietarios ya vienen de serie (lib/owner.ts). Aquí solo emails ADICIONALES.
OWNER_EMAILS=

# --- CIFRADO (tokens OAuth, claves de IA, diario) ---
# 32 bytes en base64. Genera uno con: openssl rand -base64 32
ENCRYPTION_KEY=

# --- VOCES DE GOOGLE (opcional: sobrescribe la voz Chirp 3 HD de cada personaje) ---
VOICE_BRITISH_ORIGINAL_GOOGLE=
VOICE_YOUNG_BROTHER_GOOGLE=
VOICE_DEEP_CALM_GOOGLE=
VOICE_SPANISH_BROTHER_GOOGLE=

# --- WORLDMONITOR ---
OPENWEATHER_API_KEY=

# --- NOTIFICACIONES PUSH (web-push VAPID) ---
# Genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pinchan.panchan@gmail.com

# --- STRIPE PRICE IDS (planes) ---
STRIPE_PRICE_PRO_LITE_MONTHLY=
STRIPE_PRICE_PRO_LITE_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FOUNDER_LIFETIME=

# --- OAUTH DE CONECTORES (ver docs/CONNECTORS.md) ---
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
HUE_CLIENT_ID=
HUE_CLIENT_SECRET=
# Enlace de iCloud del Atajo «J.A.R.V.I.S.» (docs/IOS_SHORTCUT.md)
NEXT_PUBLIC_IOS_SHORTCUT_URL=

# --- MODELOS DE PROVEEDORES DE IA DEL USUARIO (opcional) ---
OPENAI_CHAT_MODEL=
GROQ_CHAT_MODEL=
OPENROUTER_CHAT_MODEL=

# --- PAYPAL ---
# sandbox | live  (por defecto sandbox si el client id empieza por "sb")
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
